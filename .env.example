# Copy to .env.local for local development. Never commit real secrets.

NODE_ENV=development
APP_ENV=development
# Long random string, used to derive HMAC keys for tokens. Generate with: openssl rand -hex 32
APP_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (Vercel Postgres / Neon compatible). Pooled URL used at runtime,
# direct URL used for migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crisis_platform
DATABASE_POOL_URL=postgres://postgres:postgres@localhost:5432/crisis_platform

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Upstash Redis (REST). Leave empty to use the in-memory dev fallback (never use that in production).
REDIS_URL=
REDIS_TOKEN=

AUTH_COOKIE_NAME=crisis_session
SESSION_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# EMAIL_PROVIDER=console (default, logs to stdout) | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# LLM_PROVIDER=fake (default, deterministic, no network) | openai-compatible
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=

# EMBEDDING_PROVIDER=fake | openai-compatible
EMBEDDING_PROVIDER=fake
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# MODERATION_PROVIDER=fake | openai-compatible
MODERATION_PROVIDER=fake
MODERATION_API_KEY=

# STT_PROVIDER=disabled (default) | fake (deterministic, no network) | openai-compatible
STT_PROVIDER=disabled
STT_API_KEY=

# TTS_PROVIDER=disabled (default) | fake (deterministic, no network) | openai-compatible
TTS_PROVIDER=disabled
TTS_API_KEY=

MAX_UPLOAD_BYTES=26214400
SIGNED_URL_TTL_SECONDS=900
DEFAULT_DAILY_MESSAGE_LIMIT=200
DEFAULT_MONTHLY_TOKEN_LIMIT=2000000
DEFAULT_MONTHLY_COST_LIMIT_CENTS=5000

# JOB_PROVIDER=sync (runs inline, default for dev) | vercel-queue
JOB_PROVIDER=sync
JOB_SECRET=
CRON_SECRET=

ENABLE_VOICE=false
ENABLE_FILES=true
ENABLE_PWA=true
ENABLE_ANALYTICS=true

LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
