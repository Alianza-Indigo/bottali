{
  "name": "crisis-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && npm run db:seed && npm run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests/unit",
    "test:watch": "vitest --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "pretest:e2e": "next build",
    "test:e2e": "NODE_OPTIONS=--conditions=react-server playwright test",
    "pretest:performance": "next build",
    "test:performance": "NODE_OPTIONS=--conditions=react-server playwright test --config=playwright.performance.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "env:check": "tsx scripts/verify-env.ts",
    "pwa:icons": "tsx scripts/generate-pwa-assets.ts",
    "test:providers": "tsx scripts/test-providers.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^10.68.0",
    "@tanstack/react-query": "^5.62.11",
    "@upstash/redis": "^1.34.3",
    "@vercel/blob": "^2.6.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "mammoth": "^1.8.0",
    "nanoid": "^5.0.9",
    "next": "15.5.21",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.54.2",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.49.1",
    "@testing-library/react": "^16.1.0",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.21",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.23"
  }
}
